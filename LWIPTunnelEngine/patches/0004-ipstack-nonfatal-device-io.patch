+/// Consecutive failed writes (each already retried) after which the device is treated as gone regardless of errno.
+/// At roughly 16 ms of retries per packet this is a few seconds of nothing getting through.
+const MAX_CONSECUTIVE_WRITE_FAILURES: u32 = 200;
+
+/// Same idea for the read side (see the read branch in `run`).
+const MAX_CONSECUTIVE_READ_FAILURES: u32 = 200;
+
+/// A slower backstop than the consecutive counters: this many drops inside one window means the device is not
+/// recovering, however many isolated successes are sprinkled between them.
+const WRITE_FAILURE_WINDOW: Duration = Duration::from_secs(10);
+const MAX_WRITE_FAILURES_PER_WINDOW: u32 = 500;
+
+/// Local patch 0004. Writes one packet, retrying while the failure looks transient.
+///
+/// Darwin fails a nonblocking `AF_UNIX SOCK_DGRAM` write with ENOBUFS (os error 55) — not EWOULDBLOCK, so tokio
+/// never treats it as "try again" — once the reader falls about a megabyte behind, and it clears the moment the
+/// reader takes a single datagram. Retrying briefly keeps the packet where dropping it would silently cost
+/// throughput, and the backoff doubles as backpressure on this loop.
+async fn write_upstream_with_retry<Device: AsyncWrite + Unpin + 'static>(
+    up_packet: &NetworkPacket,
+    device: &mut Device,
+    #[cfg(unix)] packet_information: bool,
+) -> Result<()> {
+    // Kept deliberately short. This runs inside the `select!` arm, so the whole budget is time during which the
+    // device-read arm is not polled — and ENOBUFS happens exactly when the reader is behind, so a long budget
+    // would stall the upload direction to "fix" a download stall. ~1.75 ms total is enough for the reader to take
+    // one datagram, which is all that is needed to clear ENOBUFS.
+    const MAX_ATTEMPTS: usize = 4;
+    let mut delay = Duration::from_micros(250);
+    let mut attempt = 0usize;
+    loop {
+        attempt += 1;
+        match process_upstream_recv(up_packet, device, #[cfg(unix)] packet_information).await {
+            Ok(()) => return Ok(()),
+            Err(e) => {
+                let io_err: std::io::Error = e.into();
+                if device_gone(&io_err) || attempt >= MAX_ATTEMPTS {
+                    return Err(io_err.into());
+                }
+                tokio::time::sleep(delay).await;
+                delay = (delay * 2).min(Duration::from_millis(1));
+            }
+        }
+    }
+}
+
+/// True when a device I/O error means the device itself is gone, rather than a transient condition that clears
+/// once the reader drains.
+///
+/// The classification matters more than it looks: anything judged transient here is retried forever, so getting
+/// it wrong turns a dead device into a tunnel that reports Connected and silently carries nothing.
+///
+/// Measured on Darwin for the `AF_UNIX SOCK_DGRAM` socketpair this actually runs over, after the peer closes:
+/// `recv` reports **ECONNRESET (54)** once and then every later blocking `recv` hangs forever (no EOF is ever
+/// delivered), and `send` reports **EDESTADDRREQ (39)**. Both are terminal here. ENOBUFS (55) and
+/// EWOULDBLOCK/EAGAIN are the genuinely transient ones — they clear as soon as the reader takes a datagram.
+fn device_gone(e: &std::io::Error) -> bool {
+    use std::io::ErrorKind::{BrokenPipe, ConnectionReset, NotConnected, UnexpectedEof};
+    matches!(e.kind(), BrokenPipe | ConnectionReset | NotConnected | UnexpectedEof)
+        || matches!(e.raw_os_error(), Some(9) | Some(39)) // EBADF, EDESTADDRREQ
+}
