@@ -8,7 +8,16 @@ use std::{
 };
 use tproxy_config::IpCidr;
 
-const MAPPING_TIMEOUT: u64 = 60; // Mapping timeout in seconds
+// Local patch 0003. Upstream used 60 s, which is shorter than any sensible UDP session timeout: once a flow's session
+// ended, the next datagram from an app that kept using the fake address created a new session, and if any DNS lookup had
+// purged the expired mapping in between (see find_or_allocate_ip) the packet was forwarded to the raw fake 198.18.x.x
+// address and lost. Mappings now live long enough to outlast every session timeout we configure; MAX_MAPPINGS bounds
+// memory and keeps the address pool from exhausting by evicting the least-recently-used entry instead.
+const MAPPING_TIMEOUT: u64 = 24 * 60 * 60; // Mapping timeout in seconds
+const MAX_MAPPINGS: usize = 8192; // ~1 MB worst case; far above the names a phone resolves in a day
+
+// The mapping must outlive the app's UDP session timeout (120 s) with a wide margin.
+const _: () = assert!(MAPPING_TIMEOUT >= 3600);
 
 struct NameCacheEntry {
     name: String,
@@ -126,6 +135,16 @@ impl VirtualDns {
             return Ok(ip);
         }
 
+        // Bound the cache: with long-lived mappings, evict the least-recently-used entry (even if unexpired) once full.
+        while self.lru_cache.len() >= MAX_MAPPINGS {
+            match self.lru_cache.remove_lru() {
+                Some((_, entry)) => {
+                    self.name_to_ip.remove(&entry.name);
+                }
+                None => break,
+            }
+        }
+
         // Otherwise, store name and IP pair inside the LRU cache.
         let started_at = self.next_addr;
 
@@ -148,3 +167,54 @@ impl VirtualDns {
         }
